#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x=256) in;
layout(push_constant) uniform Params { uint rows; uint inner; uint columns; float inputScale; float weightScale; float outputScale; } p;
layout(set=0,binding=3,std430) readonly buffer C { int c[]; };
layout(set=0,binding=4,std430) buffer Y { float y[]; };
void main() {
 uint i=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*256+gl_LocalInvocationIndex;
 if(i<p.rows*p.columns) {
  float value=float(c[i])*(p.inputScale*p.weightScale);
  y[i]=clamp(roundEven(value/p.outputScale),-128.0,127.0)*p.outputScale;
 }
}
