// 32x32 output tile; signed INT8 cooperative matrices with INT32 accumulation.
// Each operand's 16x16 tile is contiguous, avoiding strided global gathers.
#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require
#pragma use_vulkan_memory_model
layout(local_size_x=32) in;
layout(set=0,binding=2,std430) readonly buffer A { int8_t a[]; };
layout(set=0,binding=1,std430) readonly buffer B { int8_t b[]; };
layout(set=0,binding=3,std430) buffer C { int c[]; };


layout(push_constant) uniform Params { uint rows; uint inner; uint columns; float inputScale; float weightScale; float outputScale; } p;
void main() {
 uint m=gl_WorkGroupID.y*32;
 uint n=gl_WorkGroupID.x*32;
 coopmat<int,gl_ScopeSubgroup,16,16,gl_MatrixUseAccumulator> c00=coopmat<int,gl_ScopeSubgroup,16,16,gl_MatrixUseAccumulator>(0);
 coopmat<int,gl_ScopeSubgroup,16,16,gl_MatrixUseAccumulator> c01=c00,c10=c00,c11=c00;
 for(uint kk=0;kk<p.inner;kk+=16) {
   coopmat<int8_t,gl_ScopeSubgroup,16,16,gl_MatrixUseA> a0,a1;
   coopmat<int8_t,gl_ScopeSubgroup,16,16,gl_MatrixUseB> b0,b1;
   coopMatLoad(a0,a,(m/16*(p.inner/16)+kk/16)*256,16,gl_CooperativeMatrixLayoutRowMajor);
   coopMatLoad(a1,a,((m/16+1)*(p.inner/16)+kk/16)*256,16,gl_CooperativeMatrixLayoutRowMajor);
   coopMatLoad(b0,b,(n/16*(p.inner/16)+kk/16)*256,16,gl_CooperativeMatrixLayoutColumnMajor);
   coopMatLoad(b1,b,((n/16+1)*(p.inner/16)+kk/16)*256,16,gl_CooperativeMatrixLayoutColumnMajor);
   c00=coopMatMulAdd(a0,b0,c00);c01=coopMatMulAdd(a0,b1,c01);
   c10=coopMatMulAdd(a1,b0,c10);c11=coopMatMulAdd(a1,b1,c11);
 }
 coopMatStore(c00,c,m*p.columns+n,p.columns,gl_CooperativeMatrixLayoutRowMajor);
 coopMatStore(c01,c,m*p.columns+n+16,p.columns,gl_CooperativeMatrixLayoutRowMajor);
 coopMatStore(c10,c,(m+16)*p.columns+n,p.columns,gl_CooperativeMatrixLayoutRowMajor);
 coopMatStore(c11,c,(m+16)*p.columns+n+16,p.columns,gl_CooperativeMatrixLayoutRowMajor);
}
