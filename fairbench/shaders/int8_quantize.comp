#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_8bit_storage : require
layout(local_size_x=256) in;
layout(push_constant) uniform Params { uint rows; uint inner; uint columns; float inputScale; float weightScale; float outputScale; } p;
layout(set=0,binding=0,std430) readonly buffer X { float x[]; };
layout(set=0,binding=2,std430) buffer A { int8_t a[]; };
void main() {
 uint i=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*256+gl_LocalInvocationIndex;
 if(i<p.rows*p.inner) a[i]=int8_t(clamp(roundEven(x[i]/p.inputScale),-128.0,127.0));
}
